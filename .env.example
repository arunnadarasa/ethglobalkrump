# Server
PORT=3000

# Arc / MetaMask network config (for browser wallet mode)
# Source: https://docs.arc.network/arc/references/connect-to-arc
ARC_CHAIN_ID=5042002
ARC_CHAIN_NAME=Arc Testnet
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_NATIVE_SYMBOL=USDC
ONCHAIN_TREASURY_ADDRESS=0xYourTreasuryWallet

# Circle wallet mode (server-side)
# Keep real values in .env (never commit secrets)
# Source: https://developers.circle.com/llms-full.txt
CIRCLE_API_BASE=https://api.circle.com
CIRCLE_TRANSFER_PATH=/v1/w3s/developer/transactions/transfer
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_ENTITY_SECRET_CIPHERTEXT=
# Required for Arc App Kit / Bridge Kit online mode (raw 64-char secret)
CIRCLE_ENTITY_SECRET_RAW=
CIRCLE_WALLET_ID=
CIRCLE_WALLET_ID_ONLINE=
CIRCLE_WALLET_SET_ID=
# Option A (recommended): Circle token UUID id
CIRCLE_TOKEN_ID=
# Option B: Use token address + blockchain enum from Circle docs
# Example for Arc native USDC:
CIRCLE_TOKEN_ADDRESS=0x3600000000000000000000000000000000000000
CIRCLE_TOKEN_BLOCKCHAIN=ARC-TESTNET
CIRCLE_DESTINATION_ADDRESS=0xYourDestinationOnArc

# Deep settlement mode (optional; keeps UCP core while enforcing policy checks)
ENABLE_VYPER_SETTLEMENT=true
VYPER_POLICY_MAX_TICKET_MINOR=5000
VYPER_POLICY_DAILY_CAP_MINOR=25000
ERC8004_IDENTITY_REGISTRY=
VYPER_SETTLEMENT_CONTRACT=0xYourArcSettlementContract
ERC8004_AGENT_REGISTRY=
ERC8004_AGENT_ID=
ERC8004_AGENT_TOKEN_URI=
ERC8004_AGENT_CAPABILITIES_URI=

# ENS Agent Identity (Sepolia writes, Universal Resolver reads)
# The app can resolve `context.agent_ens_name` via the ENS Universal Resolver on Sepolia,
# then use the resolved addr + ENS text records for session identity + optional intent gating.
#
# Resolution itself is server-side; writes are done via scripts/ens/setup-agent-ens.mjs.
ENS_SEPOLIA_RPC_URL=https://rpc.sepolia.org
ENS_UNIVERSAL_RESOLVER_ADDRESS=0x3c85752a5d47DD09D677C645Ff2A938B38fbFEbA
ENS_PRIVATE_KEY=
ENS_NAME=
AGENT_ARC_ADDRESS=
ENS_AGENT_ID=
ENS_TOKEN_URI=
ENS_CAPABILITIES_URI=
ENS_ALLOWED_INTENTS=
ENS_DURATION_SECONDS=31536000

# KeeperHub (OpenAgents sponsor — optional on-chain execution)
# Organization key only (prefix kh_). User webhook keys (wfb_) are for workflow webhooks, not this REST client.
# Local Arc execution key
KEEPERHUB_API_KEY_LOCAL=
# Online execution key (Sepolia/Amoy/Fuji destinations)
KEEPERHUB_API_KEY_ONLINE=
# Backward-compatible single key fallback (used if *_LOCAL/*_ONLINE are not set)
KEEPERHUB_API_KEY=
# API root must include /api (e.g. https://app.keeperhub.com/api). If you set https://app.keeperhub.com alone, the app normalizes it.
KEEPERHUB_API_BASE=https://app.keeperhub.com/api
# If Arc testnet is not auto-detected for direct execution, set the exact `network` slug from KeeperHub docs/support
KEEPERHUB_EXECUTE_NETWORK=
# Per-request execution defaults
KEEPERHUB_ONLINE_DEFAULT_NETWORK=base-sepolia
KEEPERHUB_DEFAULT_EXECUTION_MODE=online
# ERC-20 payout token (defaults to CIRCLE_TOKEN_ADDRESS). Native transfer if unset.
KEEPERHUB_TOKEN_ADDRESS=
KEEPERHUB_TOKEN_DECIMALS=6
KEEPERHUB_TOKEN_SYMBOL=USDC
KEEPERHUB_GAS_LIMIT_MULTIPLIER=1.2

# Arc App Kit bridge adapter (online execution mode)
# Source chain is Arc testnet USDC, destination chain is selected per request.
# Optional: if Polygon Amoy mint fails with NETWORK_CONNECTION_FAILED, set a dedicated RPC URL first in the list.
POLYGON_AMOY_RPC_URL=
# When true (default), public Amoy RPCs are listed before POLYGON_AMOY_RPC_URL for Bridge Kit (set false to put your RPC first).
POLYGON_AMOY_RPC_PUBLIC_FIRST=true
# FAST or SLOW for Bridge Kit CCTP (polygon-amoy defaults to SLOW when unset; set FAST to force fast burn everywhere).
ARC_BRIDGE_TRANSFER_SPEED=
# Optional: allow bridge attempt even when destination native gas is below recommended minimum.
ALLOW_LOW_DESTINATION_GAS=false
